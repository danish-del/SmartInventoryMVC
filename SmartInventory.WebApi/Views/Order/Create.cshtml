@model SmartInventory.Application.Dto.Order.CreateOrderDto
<h2>Create Orders</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="OrderId"></label>
        <input asp-for="OrderId"/>
        <span asp-validation-for="OrderId"></span>
    </div>
<div class="mb-3">
    <label asp-for="OrderNumber"></label>
    <input asp-for="OrderNumber" type="number"/>
    <span asp-validation-for="OrderNumber"></span>
</div>
<div class="mb-3">
  <label asp-for="CustomerId"></label>
  <input asp-for="CustomerId" type="number"/>
  <span asp-validation-for="CustomerId"></span>
</div>
<div class="mb-3">
    <label asp-for="OrderDate"></label>
    <input asp-for="OrderDate"/>
    <span asp-validation-for="OrderDate"></span>
</div>
    <div class="mb-3">
        <label asp-for="TotalAmount"></label>
        <input asp-for="TotalAmount" />
        <span asp-validation-for="TotalAmount"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status"></label>
        <input asp-for="Status" />
        <span asp-validation-for="Status"></span>
    </div>

    <button type="submit">Create</button>

</form>