@model SmartInventory.Application.Dto.Order.UpdateOrderDto
<h2>Edit Order</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="CustomerId"/>
    <div class="mb-3">
        <label asp-for="OrderNumber"></label>
        <input asp-for="OrderNumber"/>
        <span asp-validation-for="OrderNumber"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CustomerId"></label>
        <input asp-for="CustomerId"/>
        <span asp-validation-for="CustomerId"></span>
    </div>
    <div class="mb-3">
        <label asp-for="OrderDate"></label>
        <input asp-for="OrderDate"/>
        <span asp-validation-for="OrderDate"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TotalAmount"></label>
        <input asp-for="TotalAmount"/>
        <span asp-validation-for="TotalAmount"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status"></label>
        <input asp-for="Status" />
        <span asp-validation-for="Status"></span>
    </div>

    <button type="submit">Edit</button>


</form>