@model IEnumerable<SmartInventory.Application.Dto.Order.ResponseOrderDto>
@{
    ViewData["Title"] = "Order Dashboard";
}
<h2>Dashboard Order</h2>

<table class="table">
    <thead>
        <tr>
            <th>OrderId</th>
            <th>OrderNumber</th>
            <th>CustomerId</th>
            <th>OrderDate</th>
            <th>TotalAmount</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.OrderNumber</td>
                <td>@order.CustomerId</td>
                <td>@order.OrderDate</td>
                <td>@order.TotalAmount</td>
                <td>@order.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@order.OrderId"
                    class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@order.OrderId" 
                    class="btn btn-warning">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
