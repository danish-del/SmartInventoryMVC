@model SmartInventory.Application.Dto.Product.CreateProductDto
<h2>Create Product</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="SKU"></label>
        <input asp-for="SKU"/>
        <span asp-validation-for="SKU"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name"/>
        <span asp-validation-for="Name"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price" typeof="number"></label>
        <input asp-for="Price"/>
        <span asp-validation-for="Price"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StockQuantity" typeof="number"></label>
        <input asp-for="StockQuantity"/>
        <span asp-validation-for="StockQuantity"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoryId" typeof="number"></label>
        <input asp-for="CategoryId"/>
        <span asp-validation-for="CategoryId"></span>
    </div>
    <div class="mb-3">
        <label asp-for="isActive"></label>
        <input asp-for="isActive" />
        <span asp-validation-for="isActive"></span>
    </div>
    <button type="submit">Create</button>
</form>